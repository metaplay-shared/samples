<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- The browser platform TFM is what selects the SDK's browser flavor across the whole reference graph:
         the compiler defines BROWSER, which switches Metaplay.Client to the WebSocket transport and the
         browser blob store, and compiles out the runtime codegen mono-wasm cannot run. -->
    <TargetFramework>net10.0-browser</TargetFramework>
    <RootNamespace>Game.Client</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- CS8632: Nullable annotation used outside #nullable context -->
    <!-- CS8669: Nullable annotation in auto-generated code requires explicit #nullable directive -->
    <NoWarn>$(NoWarn);CS8632;CS8669</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>Latest</LangVersion>
    <Version>0.1.0.0</Version>
    <!-- Interpreted WASM only; AOT is out of scope. Single-threaded browser runtime. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmEnableThreads>false</WasmEnableThreads>
    <!-- The SerializerGen ProjectReference below is build-order only, but the SDK still validates it as an
         executable reference (NETSDK1150: self-contained wasm app vs framework-dependent tool). Opt out. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Metaplay source generators. Required so this (the entry) assembly carries the generated integration
         metadata that IntegrationAssembly.FindRoots() reads at startup; its reference graph then reaches GameLogic. -->
    <ProjectReference Include="..\..\..\MetaplaySDK\Backend\CodeAnalyzers\Metaplay.CodeAnalyzers.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
    <ProjectReference Include="..\..\..\MetaplaySDK\Backend\CodeAnalyzers.Shared\Metaplay.CodeAnalyzers.Shared.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
    <!-- Shared game-logic assembly (the SharedCode types). Referenced as an assembly (not source-included) so the
         pre-built serializer's assembly identity matches at runtime. GameLogic multi-targets, and this project's
         net10.0-browser TFM picks its browser flavor. -->
    <ProjectReference Include="..\SharedCode\GameLogic.csproj" />
    <ProjectReference Include="..\ClientBase\ClientBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pre-built serializer assembly (mono-wasm cannot generate one at runtime). Generated by this build
         itself into obj/ (see the GenerateBrowserSerializer target below) - never checked in. Private=true makes
         it copy-local, which is what enrolls it in the Blazor boot manifest; the SDK then loads it by name at
         startup. -->
    <Reference Include="Metaplay.Generated.Browser">
      <HintPath>$(IntermediateOutputPath)MetaplaySerializer/Metaplay.Generated.Browser.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Build-order only (ReferenceOutputAssembly=false): guarantees the generator - and with it the net10.0
         flavor of GameLogic it scans - is built before GenerateBrowserSerializer runs it. -->
    <ProjectReference Include="..\Tools\SerializerGen\SerializerGen.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot/appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Generate the serializer before this project's references are resolved. The Inputs/Outputs check skips the
       tool launch entirely when neither the game types nor the generator (which rebuilds on SDK changes) have
       changed; when it does run, SerializerGen's own source-hash cache still avoids rewriting an identical
       serializer. -->
  <Target Name="GenerateBrowserSerializer"
          BeforeTargets="ResolveAssemblyReferences"
          Inputs="..\Tools\SerializerGen\bin\$(Configuration)\net10.0\SerializerGen.dll;..\SharedCode\bin\$(Configuration)\net10.0\GameLogic.dll"
          Outputs="$(IntermediateOutputPath)MetaplaySerializer/Metaplay.Generated.Browser.dll">
    <Exec Command="dotnet exec &quot;../Tools/SerializerGen/bin/$(Configuration)/net10.0/SerializerGen.dll&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)MetaplaySerializer&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- The tool's cache-hit path leaves the file untouched, which can leave it a hair older than the freshly
         copied inputs - and then this target would rerun on every build. Stamp the output on success instead. -->
    <Touch Files="$(IntermediateOutputPath)MetaplaySerializer/Metaplay.Generated.Browser.dll" />
  </Target>

</Project>
