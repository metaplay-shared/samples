@namespace WebClient.Components
@using Game.Logic

@* One card as a small tile, as the Heist's loot lineup draws it.

   Locks ride the frame, per the design's "locks are open information" rule, and an unowned card is dimmed
   rather than hidden — an unowned card is a card worth heisting. *@

<div class="card-tile" style="background: var(--bg-card); border-color: @ClanColor; @DimStyle"
     data-testid="@TestId"
     data-card-id="@Card.CardId.Value"
     data-owned="@Owned.ToString().ToLowerInvariant()"
     data-rank="@Rank"
     data-locked="@Locked.ToString().ToLowerInvariant()">

    @* Cost, top-left on the frame — the one number that decides whether a card is playable. *@
    <span class="card-tile__cost" style="background: var(--accent-blue); color: #2a1a00;">@Card.Cost</span>

    @* An unowned card can never be locked, so the corner says so; otherwise a locked card shows its mark. *@
    @if (!Owned)
    {
        <span class="card-tile__corner card-tile__unowned" style="background: var(--bg-hover); color: var(--text-muted);">Unowned</span>
    }
    else if (Locked)
    {
        <span class="card-tile__corner card-tile__lock" title="Locked" data-testid="lock-mark">🔒</span>
    }

    <CardPortrait Card="@Card" Size="CardPortrait.PortraitSize.Grid" />
    <span class="card-tile__name" style="color: var(--text-primary);">@Card.DisplayName</span>

    <div class="card-tile__foot">
        @if (Card.Type == CardType.Critter)
        {
            <span class="card-tile__stats" style="color: var(--text-secondary);">@Stats.Attack/@Stats.Health</span>
        }
        else
        {
            <span class="card-tile__trick" style="color: var(--text-muted);">Trick</span>
        }
        <span class="card-tile__stars" style="color: var(--accent-gold);" data-testid="rank-stars">@RankStars</span>
    </div>

    @if (Badge != null)
    {
        <span class="card-tile__badge" data-testid="card-badge" style="background: var(--accent-blue); color: #2a1a00;">@Badge</span>
    }
</div>

@code {
    /// <summary> The card to draw. </summary>
    [Parameter, EditorRequired]
    public CardInfo Card { get; set; } = default!;

    /// <summary> This account's rank for the card, or 0 when it owns none. </summary>
    [Parameter]
    public int Rank { get; set; }

    /// <summary> Whether the account owns a copy. </summary>
    [Parameter]
    public bool Owned { get; set; }

    /// <summary> Whether the card sits in one of the account's lock slots. </summary>
    [Parameter]
    public bool Locked { get; set; }

    /// <summary> Draws the tile as unavailable (already in the deck, or not offerable). </summary>
    [Parameter]
    public bool Dimmed { get; set; }

    /// <summary> Optional short label under the tile, e.g. the pick affordance's hint. </summary>
    [Parameter]
    public string? Badge { get; set; }

    /// <summary> The rank ceiling, for the hollow half of the star row. From <c>Global.RankMax</c>. </summary>
    [Parameter]
    public int RankMax { get; set; } = 5;

    /// <summary>
    /// The tile's <c>data-testid</c>. Defaulted, and overridden by a screen that names its own tiles, such as the
    /// Heist lineup, so a test can find them.
    /// </summary>
    [Parameter]
    public string TestId { get; set; } = "card-tile";

    /// <summary> The card's numbers at this account's rank, which is what a player actually fields. </summary>
    CardStats Stats => Card.GetStatsAtRank(Owned ? Rank : 1);

    string ClanColor => Card.Clan?.Ref?.ColorHex ?? "var(--border-color)";

    string DimStyle => (!Owned || Dimmed) ? "opacity: 0.42;" : "";

    /// <summary> Filled stars up to the rank, hollow to the ceiling. Unowned cards show none. </summary>
    string RankStars
    {
        get
        {
            if (!Owned)
                return "";

            return new string('★', Rank) + new string('☆', Math.Max(0, RankMax - Rank));
        }
    }
}
