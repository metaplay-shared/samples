<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <Playwright>
    <!-- Run tests in headless mode (no visible browser window) -->
    <BrowserName>chromium</BrowserName>
    <LaunchOptions>
      <Headless>true</Headless>
      <!-- Set to false to see the browser for debugging:
      <Headless>false</Headless>
      <SlowMo>500</SlowMo>
      -->
    </LaunchOptions>
    <!-- How long an Expect assertion retries before it fails, when the assertion sets no Timeout of its own -->
    <ExpectTimeout>5000</ExpectTimeout>
  </Playwright>
</RunSettings>
