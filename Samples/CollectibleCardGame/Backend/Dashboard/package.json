    "bots": "dotnet run --project ../BotClient -MaxBots=10",
    "test-unit": "vitest run tests/unit/",
    "test-e2e": "playwright test",
    "typecheck": "vue-tsc --build"
  },
  "devDependencies": {
    "@metaplay/core": "workspace:^",
    "@metaplay/eslint-config": "workspace:^",
    "@metaplay/prettier-config": "workspace:^",
    "@metaplay/game-server-api": "workspace:^",
    "@metaplay/meta-ui": "workspace:^",
    "@metaplay/meta-ui-next": "workspace:^",
    "@metaplay/meta-utilities": "workspace:^",
    "@metaplay/subscriptions": "workspace:^",
    "@metaplay/tailwind-plugin": "workspace:^",
    "@metaplay/playwright-config": "workspace:^",
    "@playwright/test": "1.64.1",
    "@prettier/plugin-pug": "3.6.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "@vitejs/plugin-vue": "6.0.10",
    "@types/node": "26.6.6",
    "@vue/compat": "3.5.44",
    "@vue/language-plugin-pug": "3.3.11",
    "@vue/runtime-dom": "3.5.44",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.2",
    "pinia": "4.1.0",
    "postcss": "8.5.32",
    "pug": "3.0.4",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "eslint": "10.14.0",
    "vue-tsc": "3.3.11",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "dependencies": {
    "@types/luxon": "3.7.6",
    "luxon": "3.7.2"
  }
