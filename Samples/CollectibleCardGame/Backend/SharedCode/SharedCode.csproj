<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <RootNamespace>Game.Cloud</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same tree the client-side SharedCode.Client.csproj (living inside SharedCode/) compiles as a normal project;
         its bin/obj must be excluded here since default-glob exclusions only cover this project's own. -->
    <Compile Include="$(SharedCodePath)\**\*.cs"
             Exclude="$(SharedCodePath)\bin\**;$(SharedCodePath)\obj\**"
             LinkBase="SharedCode" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MetaplayServerPath)\Cloud\Metaplay.Cloud.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests inspect the match's hidden half, which is internal to this assembly. -->
    <InternalsVisibleTo Include="SharedCode.Tests" />
  </ItemGroup>

</Project>
