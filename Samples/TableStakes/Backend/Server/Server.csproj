<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Version>0.1.0.0</Version>
    <LangVersion>Latest</LangVersion>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <StartWorkingDirectory>.</StartWorkingDirectory>
    <ExternalConsole>true</ExternalConsole>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedCode\SharedCode.csproj" />
    <ProjectReference Include="$(MetaplayServerPath)\Server\Metaplay.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published Blazor WASM WebClient. tools/ServerImageBuild.cs copies it here before the Docker image
         build, and publish copies it to publicwebapp/ in the output, which is the cloud default for
         WebClientHosting.WebRootPath. Only publish copies it, so a normal build or `metaplay dev server` does not
         need the directory to exist. -->
    <None Remove="publicwebapp\**" />
    <Content Include="publicwebapp\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
