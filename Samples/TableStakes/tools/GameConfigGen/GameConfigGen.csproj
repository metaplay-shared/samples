<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline game config build (see GameConfigBuildTool in Program.cs and docs/game-config.md).

    The tool references the Server project, not only SharedCode, so that it loads the same integration types
    as the server. The SDK's integration registry picks the most derived implementation it finds, and some of
    the game's implementations are in the server assembly. The sheet check also reads the server config type.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>Latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.1.0.0</Version>
    <!-- Run in the caller's working directory, not the project directory. The tool searches upward from
         there for metaplay-project.yaml and resolves all paths against that directory. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK's integration discovery reads source-generated type info from the entry assembly, so the tool
         needs the Metaplay analyzers like every other Metaplay assembly. -->
    <ProjectReference Include="..\..\..\..\MetaplaySDK\Backend\CodeAnalyzers\Metaplay.CodeAnalyzers.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
    <ProjectReference Include="..\..\..\..\MetaplaySDK\Backend\CodeAnalyzers.Shared\Metaplay.CodeAnalyzers.Shared.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
    <ProjectReference Include="..\..\Backend\Server\Server.csproj" />
  </ItemGroup>

</Project>
