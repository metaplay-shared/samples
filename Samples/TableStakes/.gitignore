# Visual Studio cache directory
.vs/

# Visual Studio launch profiles not shared (TableStakes.slnLaunch holds the shared ones)
*.slnLaunch.user

### Metaplay-related ignores

# Build outputs
**/out/
**/bin/
**/obj/

# State dumps from checksum mismatches with server
StateDump_*.txt

# Metaplay Agent
/.claude/metaplay-plugin-assets-dir
/.claude/scheduled_tasks.lock
/.claude/worktrees/

# Per-user Claude Code settings (machine-specific; shared defaults live in settings.json)
/.claude/settings.local.json
**/node_modules/

# Metaplay client storage
**/PersistentData/
**/TemporaryCache/

# Python bytecode cache
__pycache__/
