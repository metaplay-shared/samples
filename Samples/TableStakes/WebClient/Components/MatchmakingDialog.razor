@namespace WebClient.Components
@using Game.Logic
@using Metaplay.Core
@using WebClient.Services
@inject MetaplayClientService MetaplayService
@implements IDisposable

@* The searching dialog shown while matchmaking runs, over the screen where the player tapped Play
   (docs/meta-shell.md, "Screens and routes"). It counts down to the server's seating deadline, with the text
   and rounding from MatchmakingWaitText. Once the seat is committed, Cancel stays visible but disabled, and the
   text does not change, because that state lasts one round trip and a change would flash.

   The headline is rendered here instead of through Panel's Title because it needs the searching-text test id.
   Panel's tabindex="-1" keeps focus inside the dialog after Cancel is disabled. *@

@if (MetaplayService.IsMatchmaking)
{
    @* Read the clock once per render, so the countdown and the detail line use the same value. *@
    MetaDuration remaining = Remaining;

    <ModalPanel TestId="searching" Width="PanelWidth.Narrow" Eyebrow="Matchmaking" AriaLabel="Finding a table">
        <h2 class="pnl__title" data-testid="searching-text">@MatchmakingWaitText.Headline</h2>

        @* The spinner turns for the whole wait. The countdown number is shown only when there is a deadline:
           not before the server's first answer arrives, and not after the deadline has passed. *@
        <div class="ts-mm__dial">
            <div class="ts-mm__spinner" aria-hidden="true"></div>
            @if (MatchmakingWaitText.HasCountdown(remaining))
            {
                <span class="ts-mm__seconds"
                      role="timer"
                      aria-label="@($"About {MatchmakingWaitText.SecondsShown(remaining)} seconds until you are seated")"
                      data-testid="searching-countdown">@MatchmakingWaitText.SecondsShown(remaining)</span>
            }
        </div>

        <p class="ts-mm__detail" data-testid="searching-detail">@MatchmakingWaitText.Detail(remaining)</p>

        <button type="button" class="strip ts-btn--dark ts-btn--dark--md ts-mm__cancel" data-testid="cancel-search"
                disabled="@(!MatchmakingWaitText.CanCancel(MetaplayService.MatchmakingStatus))" @onclick="OnCancel">Cancel</button>
    </ModalPanel>
}

@code {
    /// <summary>
    /// Subscribes to the client service, which raises <c>OnStateChanged</c> on every frame while connected, so the
    /// countdown to the seating deadline, which no server update marks, moves on its own.
    /// </summary>
    protected override void OnInitialized()
    {
        MetaplayService.OnStateChanged += OnStateChanged;
    }

    /// <summary>
    /// The time left until the seating deadline, or zero when there is no deadline.
    /// <para>
    /// It uses authoritative time (the client's estimate of the server clock), because the server wrote the
    /// deadline in that clock. Presented time belongs to the animated table board, which does not exist yet
    /// (docs/web-client.md, "The table's two clocks").
    /// </para>
    /// </summary>
    private MetaDuration Remaining
    {
        get
        {
            MetaTime seatBy = MetaplayService.MatchmakingSeatDeadlineAt;
            if (seatBy <= MetaTime.Epoch)
                return MetaDuration.Zero;
            return AuthoritativeTime.Now.RemainingUntil(seatBy);
        }
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Asks the server to cancel matchmaking. The dialog closes only when the server confirms, because the
    /// server refuses a cancel that arrives after the seat is committed, and the player is then seated.
    /// </summary>
    private void OnCancel() => MetaplayService.CancelMatchmaking();

    public void Dispose()
    {
        MetaplayService.OnStateChanged -= OnStateChanged;
    }
}
