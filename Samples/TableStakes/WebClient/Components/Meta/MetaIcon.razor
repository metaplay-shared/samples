@* The shell's icon set as inline SVG, so icons need no download, stay sharp at any size, and follow the
   design tokens (docs/meta-shell.md, "Styles and design tokens"). Icons use currentColor, so they take the
   colour of the parent element.

   The shell always writes a text label beside an icon, so icons are decorative unless Label is set. *@

<svg class="m-icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none"
     stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Label == null ? "true" : null)" role="@(Label == null ? null : "img")">
    @if (Label != null)
    {
        <title>@Label</title>
    }
    @Body
</svg>

@code {
    /// <summary>The icon name. An unknown name draws an empty icon instead of throwing.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>The width and height in pixels.</summary>
    [Parameter] public int Size { get; set; } = 22;

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// The accessible name, for an icon that has no text label beside it. When null, the icon is hidden from
    /// assistive technology.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    private RenderFragment Body => Name switch
    {
        // --- Navigation ---
        "home"     => @<g><path d="M3 10.2 12 3l9 7.2" /><path d="M5.5 9.2V20h13V9.2" /><path d="M9.6 20v-5.4h4.8V20" /></g>,
        "calendar" => @<g><rect x="3" y="5" width="18" height="16" rx="2.5" /><path d="M3 10h18M8 3v4M16 3v4" /><path d="m12 13.2 1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2L8.8 15.5l2.2-.3z" /></g>,
        "cards"    => @<g><rect x="7.5" y="4" width="11" height="15" rx="2" transform="rotate(9 13 11.5)" /><rect x="4" y="6" width="11" height="15" rx="2" transform="rotate(-8 9.5 13.5)" /></g>,
        "trophy"   => @<g><path d="M7 4h10v5a5 5 0 0 1-10 0z" /><path d="M7 6H4.5v1.5A3.5 3.5 0 0 0 8 11" /><path d="M17 6h2.5v1.5A3.5 3.5 0 0 1 16 11" /><path d="M12 14v3.5M8.5 21h7l-.8-3.5h-5.4z" /></g>,
        "bag"      => @<g><path d="M4.5 8h15l-1.2 12.2a1.6 1.6 0 0 1-1.6 1.4H7.3a1.6 1.6 0 0 1-1.6-1.4z" /><path d="M8.6 8V6.2a3.4 3.4 0 0 1 6.8 0V8" /></g>,

        // --- Currencies ---
        // Currency icons are partly filled, unlike the other outline icons, so each currency is recognisable by
        // its shape.
        "coin"       => @<g><circle cx="12" cy="12" r="8.6" fill="currentColor" opacity="0.22" /><circle cx="12" cy="12" r="8.6" /><circle cx="12" cy="12" r="6.2" opacity="0.6" /><path d="M12 8.2c-1.9 1.7-3 2.9-3 4.1a3 3 0 0 0 6 0c0-1.2-1.1-2.4-3-4.1z" fill="currentColor" stroke="none" /><path d="M11.2 15.8h1.6" /></g>,
        "gem"        => @<g><path d="m12 3.6 6.4 4.2L12 20.4 5.6 7.8z" fill="currentColor" opacity="0.24" /><path d="m12 3.6 6.4 4.2L12 20.4 5.6 7.8z" /><path d="M5.6 7.8h12.8M9.4 7.8 12 20.4l2.6-12.6M9.4 7.8 12 3.6l2.6 4.2" /></g>,
        "spin-token" => @<g><circle cx="12" cy="12" r="8.6" fill="currentColor" opacity="0.22" /><circle cx="12" cy="12" r="8.6" /><circle cx="12" cy="12" r="5.9" opacity="0.55" /><path d="M12 3.4v2.2M12 18.4v2.2M3.4 12h2.2M18.4 12h2.2M6 6l1.6 1.6M16.4 16.4 18 18M18 6l-1.6 1.6M7.6 16.4 6 18" /><path d="M12 9.6a1.5 1.5 0 1 0-1.1 2.5 1.5 1.5 0 1 0 1 2.4h.2a1.5 1.5 0 1 0 1-2.4A1.5 1.5 0 1 0 12 9.6z" fill="currentColor" stroke="none" /></g>,

        // --- Feature emblems ---
        "chest"  => @<g><path d="M4 10.4A2.4 2.4 0 0 1 6.4 8h11.2A2.4 2.4 0 0 1 20 10.4V19H4z" /><path d="M4 13.4h16" /><path d="M12 8V5.6M9 8a3 3 0 0 1 6 0" /><rect x="10.4" y="12" width="3.2" height="3.4" rx="1" /></g>,
        "wheel"  => @<g><circle cx="12" cy="12.6" r="7.4" /><circle cx="12" cy="12.6" r="1.6" /><path d="M12 5.2v5.8M12 14.2v5.8M4.6 12.6h5.8M13.6 12.6h5.8M6.8 7.4l4.1 4.1M13.1 13.7l4.1 4.1M17.2 7.4l-4.1 4.1M10.9 13.7l-4.1 4.1" /><path d="M12 2.4 13.4 5h-2.8z" /></g>,
        "shield" => @<g><path d="M12 3.2 19 6v6.2c0 4-2.8 7.2-7 8.6-4.2-1.4-7-4.6-7-8.6V6z" /><path d="M12 8.4 13.3 11l2.9.3-2.2 2 .7 2.8-2.7-1.5-2.7 1.5.7-2.8-2.2-2 2.9-.3z" /></g>,
        "star"   => @<path d="m12 3.6 2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.8l5.9-.8z" />,
        "flame"  => @<g><path d="M12 3.2s4.8 4 4.8 8.6a4.8 4.8 0 0 1-9.6 0C7.2 7.2 12 3.2 12 3.2z" /><path d="M12 20.6a2.7 2.7 0 0 1-2.7-2.7c0-1.9 2.7-4.1 2.7-4.1s2.7 2.2 2.7 4.1A2.7 2.7 0 0 1 12 20.6z" /></g>,
        // Shop bundle icons, named by their contents.
        "chest-gems" => @<g><path d="M4 11.4A2.4 2.4 0 0 1 6.4 9h11.2A2.4 2.4 0 0 1 20 11.4V20H4z" /><path d="M4 14.4h16" /><rect x="10.4" y="13" width="3.2" height="3.4" rx="1" /><path d="m8 7.4 1.6-2.8 1.6 2.8-1.6 2.6zM15 6.2l1.3-2.2 1.3 2.2-1.3 2.1z" /></g>,
        "chest-plum" => @<g><path d="M4 10.4A2.4 2.4 0 0 1 6.4 8h11.2A2.4 2.4 0 0 1 20 10.4V19H4z" /><path d="M4 13.4h16M8 8v11M16 8v11" /><rect x="10.4" y="12" width="3.2" height="3.4" rx="1" /></g>,
        "card-pack"  => @<g><rect x="6" y="3.4" width="12" height="17.2" rx="2" /><path d="M6 8h12" /><path d="m12 11.4-2.4 2.6a3.3 3.3 0 0 0 3.6 5.2 3.3 3.3 0 0 0 1.2-5.2z" /></g>,
        "vault"  => @<g><rect x="3.4" y="4.4" width="17.2" height="15.2" rx="2.4" /><circle cx="12" cy="12" r="4.2" /><path d="M12 7.8v1.6M12 14.6v1.6M7.8 12h1.6M14.6 12h1.6" /></g>,
        "frame"  => @<g><circle cx="12" cy="12" r="7.6" /><path d="m12 3.2 1.8 2.2L12 7.6l-1.8-2.2z" /><path d="m12 16.4 1.8 2.2L12 20.8l-1.8-2.2z" /></g>,
        "spade"  => @<path d="M12 3.4 6.2 9.6a3.9 3.9 0 0 0 4.3 6.3l-1.4 4.7h5.8l-1.4-4.7a3.9 3.9 0 0 0 4.3-6.3z" fill="currentColor" stroke="none" />,
        "gift"   => @<g><rect x="3.6" y="9.4" width="16.8" height="10.8" rx="1.8" /><path d="M2.6 6.4h18.8v3H2.6zM12 6.4v13.8" /><path d="M12 6.4C10.6 3.2 6.4 3.4 7.4 6.4M12 6.4c1.4-3.2 5.6-3 4.6 0" /></g>,
        "medal"  => @<g><circle cx="12" cy="14.4" r="5.4" /><path d="M12 11.8l1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2-1.6-1.5 2.2-.3z" /><path d="M8.4 9.6 6.4 3.4h11.2l-2 6.2" /></g>,
        "target" => @<g><circle cx="12" cy="12" r="8.4" /><circle cx="12" cy="12" r="4.6" /><circle cx="12" cy="12" r="1.1" fill="currentColor" stroke="none" /></g>,

        // Spin wheel results that are not amounts: the skull for a blank segment and the arrow for a respin.
        "skull"  => @<g><path d="M5.4 11.8a6.6 6.6 0 0 1 13.2 0v3a2 2 0 0 1-2 2H7.4a2 2 0 0 1-2-2z" /><circle cx="9.3" cy="12.2" r="1.6" fill="currentColor" stroke="none" /><circle cx="14.7" cy="12.2" r="1.6" fill="currentColor" stroke="none" /><path d="M10.1 16.8v2.4M12 16.8v2.4M13.9 16.8v2.4" /></g>,
        "respin" => @<g><path d="M19.5 9.3A8 8 0 1 1 16 5.1" /><path d="M18.9 6.8 14.8 7.2 17.2 3z" fill="currentColor" stroke="none" /></g>,

        // --- State and controls ---
        "clock"   => @<g><circle cx="12" cy="12" r="8.4" /><path d="M12 7.4V12l3 1.8" /></g>,
        "check"   => @<g><circle cx="12" cy="12" r="8.4" /><path d="m8.4 12.2 2.6 2.6 4.6-5.2" /></g>,
        "lock"    => @<g><rect x="5.2" y="10.4" width="13.6" height="9.6" rx="2.2" /><path d="M8.4 10.4V7.6a3.6 3.6 0 0 1 7.2 0v2.8" /></g>,
        "back"    => @<path d="M14.6 5.4 8 12l6.6 6.6" />,
        "pencil"  => @<g><path d="m4.6 19.4.6-3.4L15.8 5.4a2 2 0 0 1 2.8 0l0 0a2 2 0 0 1 0 2.8L8 18.8z" /><path d="m14.4 6.8 2.8 2.8" /></g>,
        "up"      => @<path d="m12 18.6V5.4M6.6 10.8 12 5.4l5.4 5.4" />,
        "down"    => @<path d="M12 5.4v13.2M17.4 13.2 12 18.6l-5.4-5.4" />,
        "dash"    => @<path d="M6.4 12h11.2" />,
        "warning" => @<g><path d="M12 4.2 21 19.8H3z" /><path d="M12 10v4M12 16.8v.4" /></g>,
        "offline" => @<g><path d="M3 4.2 21 20.4" /><path d="M5.2 10.6a11 11 0 0 1 4-2.4M2.6 7.4a15 15 0 0 1 3.6-2.3M18 10.8a11 11 0 0 0-3-2M21.4 7.6a15 15 0 0 0-4-2.5" /><path d="M9 14.4a6 6 0 0 1 5.4-.6" /><path d="M12 18.6v.4" /></g>,
        "retry"   => @<g><path d="M20 12a8 8 0 1 1-2.6-5.9" /><path d="M20.4 4v4.4H16" /></g>,
        "close"   => @<path d="M6.6 6.6 17.4 17.4M17.4 6.6 6.6 17.4" />,
        _         => @<g></g>,
    };
}
