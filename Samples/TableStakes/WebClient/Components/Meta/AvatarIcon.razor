@* The inline SVG glyphs for the avatar cosmetics.

   There is one glyph per Avatar-slot CosmeticStyle (SharedCode/GameConfigs/Cosmetics.cs). The switch keys are
   the style tokens, and a coverage test in WebClient.Tests checks them against the enum. An empty or unknown
   token draws the spade, which is also the avatar every player owns from the start (docs/cosmetics.md,
   "The starting three").

   The glyphs use currentColor, like MetaIcon, so they take the colour of the parent element. Unlike
   MetaIcon's outline icons they are filled, because filled shapes stay readable at small sizes such as a
   standings row. *@

<svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="currentColor" aria-hidden="true" data-token="@Token">@Body</svg>

@code {
    /// <summary>
    /// The style token of the worn avatar, such as <c>avatar-heart</c>, or empty for the default. An unknown
    /// token draws the spade instead of throwing.
    /// </summary>
    [Parameter, EditorRequired] public string Token { get; set; } = "";

    /// <summary>
    /// The width and height in pixels. Inside <c>m-avatar__face</c> the stylesheet overrides it and the glyph
    /// scales with the frame.
    /// </summary>
    [Parameter] public int Size { get; set; } = 22;

    private RenderFragment Body => Token switch
    {
        "avatar-spade"   => Spade,
        "avatar-heart"   => @<path d="M12 20.9C6.4 16.2 3.2 12.8 3.2 9.2a4.9 4.9 0 0 1 8.8-3 4.9 4.9 0 0 1 8.8 3c0 3.6-3.2 7-8.8 11.7z" />,
        "avatar-diamond" => @<path d="M12 2.4 20.2 12 12 21.6 3.8 12z" />,
        "avatar-club"    => @<path d="M12 3.2a3.7 3.7 0 0 0-3.5 4.9 3.7 3.7 0 1 0-1.5 7c1.5 0 2.6-.7 3.3-1.7l-.9 7.4h5.2l-.9-7.4c.7 1 1.8 1.7 3.3 1.7a3.7 3.7 0 1 0-1.5-7A3.7 3.7 0 0 0 12 3.2z" />,
        "avatar-ace"     => @<path fill-rule="evenodd" d="M7.4 3.2h9.2c1 0 1.8.8 1.8 1.8v14c0 1-.8 1.8-1.8 1.8H7.4c-1 0-1.8-.8-1.8-1.8V5c0-1 .8-1.8 1.8-1.8zm4.6 4.4-2.8 4.5a2.2 2.2 0 0 0 2.4 3.5l-.8 2.8h2.4l-.8-2.8a2.2 2.2 0 0 0 2.4-3.5z" />,
        "avatar-joker"   => @<g><path d="M12 7.2c-.9-2.2-2.5-3.6-4.6-3.6C4.6 3.6 3 6 3.7 8.7l1.6 6.5h13.4l1.6-6.5c.7-2.7-.9-5.1-3.7-5.1-2.1 0-3.7 1.4-4.6 3.6z" /><circle cx="12" cy="5" r="1.9" /><circle cx="4.3" cy="6.7" r="1.6" /><circle cx="19.7" cy="6.7" r="1.6" /><rect x="4.8" y="16.6" width="14.4" height="2.7" rx="1.35" /></g>,
        "avatar-crown"   => @<g><path d="M4.4 7.4 9 10.8l3-6.2 3 6.2 4.6-3.4-1.6 9.8H6z" /><rect x="6" y="18.4" width="12" height="2.2" rx="1.1" /></g>,
        "avatar-dice"    => @<path fill-rule="evenodd" d="M6.2 3.8h11.6c1.3 0 2.4 1.1 2.4 2.4v11.6c0 1.3-1.1 2.4-2.4 2.4H6.2c-1.3 0-2.4-1.1-2.4-2.4V6.2c0-1.3 1.1-2.4 2.4-2.4zm2.3 3.1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm7 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm-3.5 3.6a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm-3.5 3.6a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm7 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z" />,
        "avatar-chip"    => @<path fill-rule="evenodd" d="M12 3.2a8.8 8.8 0 1 1 0 17.6 8.8 8.8 0 0 1 0-17.6zm0 4.2a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2zM11.1 3.4h1.8v4.2h-1.8zM11.1 16.4h1.8v4.2h-1.8zM3.4 11.1h4.2v1.8H3.4zM16.4 11.1h4.2v1.8h-4.2z" />,
        "avatar-trump"   => @<path d="m12 3.2 2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.7l6.1-.9z" />,

        // An empty or unknown token draws the spade. avatar-spade also has its own arm above, so every enum
        // value has an explicit arm.
        _                => Spade,
    };

    /// <summary>The spade glyph, drawn for avatar-spade and for an empty or unknown token.</summary>
    private static RenderFragment Spade => @<path d="M12 3.4 6.2 9.6a3.9 3.9 0 0 0 4.3 6.3l-1.4 4.7h5.8l-1.4-4.7a3.9 3.9 0 0 0 4.3-6.3z" />;
}
