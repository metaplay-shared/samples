@* An on/off switch. It is a switch rather than a checkbox because the setting takes effect immediately, with
   no form to submit.

   It is a button with role="switch", so it is focusable and keyboard-operable, and its state is exposed in
   aria-checked. The visible label is drawn by the calling screen, and Label passes the same text as the
   accessible name. *@

<button type="button" class="m-toggle" role="switch"
        aria-checked="@(Checked ? "true" : "false")"
        aria-label="@Label" data-testid="@TestId" disabled="@Disabled"
        @onclick="Toggle">
    <span class="m-toggle__knob" aria-hidden="true"></span>
</button>

@code {
    [Parameter] public bool Checked { get; set; }

    /// <summary>Raised with the new state when the switch is flipped. The caller applies the setting and updates Checked.</summary>
    [Parameter] public EventCallback<bool> OnToggle { get; set; }

    /// <summary>The switch's accessible name. Use the text shown beside the switch.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? TestId { get; set; }

    private Task Toggle() => OnToggle.InvokeAsync(!Checked);
}
