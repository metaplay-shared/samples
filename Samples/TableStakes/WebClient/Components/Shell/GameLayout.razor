@inherits LayoutComponentBase
@inject MetaplayClientService MetaplayService

@* The layout for game routes: no HUD and no navigation. Each route declares its layout (meta routes use
   MetaLayout, game routes use GameLayout), so no screen decides at runtime whether the shell is shown
   (docs/meta-shell.md, "Layouts").

   The phone frame is drawn by #app on every route (app.css, "The phone frame"), not by this layout. *@

<main>
    @Body
</main>

@code {
    /// <summary>
    /// Starts the client service. The layout starts it, not the table page, as MetaLayout does for the meta routes.
    /// </summary>
    protected override void OnInitialized() => MetaplayService.Start();
}
