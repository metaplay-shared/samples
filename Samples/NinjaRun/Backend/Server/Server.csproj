<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Version>0.1.0.0</Version>
    <LangVersion>Latest</LangVersion>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <StartWorkingDirectory>.</StartWorkingDirectory>
    <ExternalConsole>true</ExternalConsole>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedCode\SharedCode.csproj" />
    <ProjectReference Include="$(MetaplayServerPath)\Server\Metaplay.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published Blazor WASM WebClient, staged here by tools/ServerImageBuild.cs before the
         Docker image build. Copied into the publish output at publicwebapp/, which is where the
         cloud-default WebClientHosting.WebRootPath points. Publish only, so a plain build or
         `metaplay dev server` is unaffected; the directory is absent (and ignored) in normal work. -->
    <None Remove="publicwebapp\**" />
    <Content Include="publicwebapp\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
