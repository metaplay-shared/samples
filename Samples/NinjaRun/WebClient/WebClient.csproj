<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- The browser platform TFM is what selects the SDK's browser flavor across the whole reference graph:
         the compiler defines BROWSER, which switches Metaplay.Client to the WebSocket transport and the
         browser blob store, and compiles out the runtime codegen mono-wasm cannot run. -->
    <TargetFramework>net10.0-browser</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- CS8632: Nullable annotation used outside #nullable context -->
    <!-- CS8669: Nullable annotation in auto-generated code requires explicit #nullable directive -->
    <NoWarn>$(NoWarn);CS8632;CS8669</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>Latest</LangVersion>
    <!-- Interpreted WASM only; AOT is out of scope. Single-threaded browser runtime. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmEnableThreads>false</WasmEnableThreads>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Metaplay source generators. Required so this (the entry) assembly carries the generated integration
         metadata that IntegrationAssembly.FindRoots() reads at startup; its reference graph then reaches GameLogic. -->
    <ProjectReference Include="..\..\..\MetaplaySDK\Backend\CodeAnalyzers\Metaplay.CodeAnalyzers.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
    <ProjectReference Include="..\..\..\MetaplaySDK\Backend\CodeAnalyzers.Shared\Metaplay.CodeAnalyzers.Shared.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Analyzer</OutputItemType>
    </ProjectReference>
    <!-- Shared game-logic assembly (the SharedCode types). Referenced as an assembly (not source-included) so the
         pre-built serializer's assembly identity matches at runtime. GameLogic multi-targets, and this project's
         net10.0-browser TFM picks its browser flavor. -->
    <ProjectReference Include="..\GameLogic\GameLogic.csproj" />
    <ProjectReference Include="..\WebClientBase\WebClientBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pre-built serializer assembly, because mono-wasm cannot generate one at runtime. It is not committed.
         The import below generates it with tools/SerializerGen before references are resolved. -->
    <Reference Include="Metaplay.Generated.Browser">
      <HintPath>Serializer\Metaplay.Generated.Browser.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Import Project="..\tools\SerializerGen\BrowserSerializer.targets" />

</Project>
