<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Client build of the game logic in this directory, which the client and the server share.

    The server compiles the same sources in Backend/SharedCode/SharedCode.csproj, against Metaplay.Cloud. The two
    builds cannot be one assembly: Metaplay.Cloud and Metaplay.Client each compile the SDK's core types into
    themselves, so the game logic has to be compiled against each. The server project excludes this project's
    bin/ and obj/ from its source glob.

    The WebAssembly client cannot generate its serializer at runtime (mono-wasm has no Reflection.Emit / Roslyn),
    so it loads a pre-built Metaplay.Generated.Browser.dll. That generated assembly references the concrete game
    types (PlayerModel, PlayerActions, ...) *by assembly identity*. To make the identity match between the
    build-time generator (tools/SerializerGen) and the runtime app (WebClient), both reference this one project
    rather than source-including the game logic into each.
  -->
  <PropertyGroup>
    <!-- Two flavors, mirroring Metaplay.Client: net10.0-browser for the WebClient app (the compiler's BROWSER
         define selects the SDK's WebSocket transport and compiles out runtime codegen), and net10.0 for
         tools/SerializerGen, which needs the full .NET host to generate the serializer. Both produce the same
         SharedCode.Client assembly identity, which is what the pre-built serializer binds against. -->
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <LangVersion>Latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0.0</Version>
    <!-- CS8632/CS8669: nullable annotations used while Nullable is disabled. -->
    <NoWarn>$(NoWarn);CS8632;CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MetaplaySDKPath)\Dotnet\Client\Metaplay.Client.csproj" />
  </ItemGroup>

</Project>
